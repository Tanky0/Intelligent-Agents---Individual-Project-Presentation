# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- LLM ---------------------------------------------------------------
# Gemini 3.6 Flash, free tier: https://aistudio.google.com -> Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- NCBI E-utilities (PubMed / PMC) -----------------------------------
# NCBI requires a registered tool name and contact email. Without an API key
# the documented ceiling is 3 requests/second; with one it is 10. The rate
# limiter reads these values, so they are enforced in code, not just declared.
NCBI_API_KEY=
NCBI_EMAIL=
NCBI_TOOL=uoeo-research-agent

# --- Semantic Scholar ---------------------------------------------------
# Optional. Keys are issued on request and are not always granted quickly, so
# the adapter must work unauthenticated against the shared pool (expect 429s).
SEMANTIC_SCHOLAR_API_KEY=

# --- Crossref -----------------------------------------------------------
# No key required. Supplying a mailto joins the "polite pool" (better limits).
CROSSREF_EMAIL=

# --- How to run ---------------------------------------------------------
# RECORD_REPLIES saves each reply as it arrives, into data/captured_replies.
# It is on by default; a demonstration set that relies on remembering to switch
# it on beforehand will eventually be missing. Nothing is replayed from there:
# run scripts/approve_replies.py to move a reply into the set a demonstration
# uses. DEMO_MODE sends nothing at all and replays only approved replies.
DEMO_MODE=false
RECORD_REPLIES=true
